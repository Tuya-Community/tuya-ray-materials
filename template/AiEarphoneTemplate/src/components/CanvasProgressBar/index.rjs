// 默认配置
const defaultPercent = 0;
const defaultWidth = '100%';
const defaultHeight = 8; // 单位px
const defaultFillColor = '#3678E3';
const defaultTrackColor = 'rgba(54, 120, 227, 0.1)';
const defaultBorderRadius = 16; // 单位px

let percent = defaultPercent;
let width = defaultWidth;
let height = defaultHeight;
let fillColor = defaultFillColor;
let trackColor = defaultTrackColor;
let borderRadius = defaultBorderRadius;
let actualWidth = 0; // 实际宽度（px）

let ctx = null;
let dpr = 1; // 设备像素比

// 将颜色字符串转换为canvas可用的格式
function parseColor(color) {
  if (!color) return '#000000';
  
  // 如果是rgba或rgb格式，直接返回
  if (color.startsWith('rgba') || color.startsWith('rgb')) {
    return color;
  }
  
  // 如果是十六进制格式
  if (color.startsWith('#')) {
    // 处理3位十六进制颜色（如#fff）
    if (color.length === 4) {
      const r = parseInt(color[1] + color[1], 16);
      const g = parseInt(color[2] + color[2], 16);
      const b = parseInt(color[3] + color[3], 16);
      return `rgb(${r}, ${g}, ${b})`;
    }
    // 处理6位十六进制颜色（如#ffffff）
    if (color.length === 7) {
      const r = parseInt(color.slice(1, 3), 16);
      const g = parseInt(color.slice(3, 5), 16);
      const b = parseInt(color.slice(5, 7), 16);
      return `rgb(${r}, ${g}, ${b})`;
    }
  }
  
  return color;
}

// 绘制圆角矩形
function drawRoundedRect(ctx, x, y, width, height, radius) {
  ctx.beginPath();
  ctx.moveTo(x + radius, y);
  ctx.lineTo(x + width - radius, y);
  ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
  ctx.lineTo(x + width, y + height - radius);
  ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
  ctx.lineTo(x + radius, y + height);
  ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
  ctx.lineTo(x, y + radius);
  ctx.quadraticCurveTo(x, y, x + radius, y);
  ctx.closePath();
}

// 绘制进度条
function drawProgressBar() {
  if (!ctx || actualWidth === 0) return;

  // 确保圆角半径不超过高度的一半
  const maxRadius = height / 2;
  const effectiveRadius = Math.min(borderRadius, maxRadius);

  // 清除画布（context已经scale了dpr，所以使用逻辑尺寸）
  ctx.clearRect(0, 0, actualWidth, height);

  // 计算填充宽度
  const fillWidth = (actualWidth * percent) / 100;
  const fillWidthPx = Math.max(0, Math.min(fillWidth, actualWidth));

  // 绘制背景轨道（先绘制，作为底层）
  // context已经在pageDraw中scale了dpr，所以这里直接使用逻辑尺寸绘制
  drawRoundedRect(ctx, 0, 0, actualWidth, height, effectiveRadius);
  ctx.fillStyle = parseColor(trackColor);
  ctx.fill();

  // 绘制填充进度（后绘制，覆盖在轨道上）
  if (fillWidthPx > 0) {
    // 填充进度的圆角半径
    // 如果填充宽度小于等于圆角直径，使用填充宽度的一半作为圆角（但不能超过有效圆角）
    // 否则使用完整的有效圆角
    let fillRadius = effectiveRadius;
    if (fillWidthPx < effectiveRadius * 2) {
      fillRadius = Math.min(fillWidthPx / 2, effectiveRadius);
    }
    
    // 绘制填充的圆角矩形
    drawRoundedRect(ctx, 0, 0, fillWidthPx, height, fillRadius);
    ctx.fillStyle = parseColor(fillColor);
    ctx.fill();
  }
}

export default Render({
  init(percentParam, widthParam, heightParam, fillColorParam, trackColorParam, borderRadiusParam) {
    percent = percentParam !== undefined ? percentParam : defaultPercent;
    width = widthParam !== undefined ? widthParam : defaultWidth;
    height = heightParam !== undefined ? heightParam : defaultHeight;
    fillColor = fillColorParam || defaultFillColor;
    trackColor = trackColorParam || defaultTrackColor;
    borderRadius = borderRadiusParam !== undefined ? borderRadiusParam : defaultBorderRadius;
  },

  pageDraw(dprParam, canvasWidth) {
    dpr = dprParam || 1;
    
    // 直接使用传入的canvasWidth（已经是计算好的像素值）
    actualWidth = canvasWidth || 300;

    getCanvasById('canvasProgressBar', this).then(canvas => {
      ctx = canvas.getContext('2d');
      
      // 设置canvas实际尺寸（考虑设备像素比）
      canvas.width = actualWidth * dpr;
      canvas.height = height * dpr;

      // 缩放坐标系，使得绘制时仍然使用逻辑尺寸
      ctx.scale(dpr, dpr);

      // 绘制进度条
      drawProgressBar();
    });
  },

  // 更新配置
  updateConfig(percentParam, widthParam, heightParam, fillColorParam, trackColorParam, borderRadiusParam, canvasWidth) {
    percent = percentParam !== undefined ? percentParam : percent;
    width = widthParam !== undefined ? widthParam : width;
    height = heightParam !== undefined ? heightParam : height;
    fillColor = fillColorParam || fillColor;
    trackColor = trackColorParam || trackColor;
    borderRadius = borderRadiusParam !== undefined ? borderRadiusParam : borderRadius;

    // 直接使用传入的canvasWidth（已经是计算好的像素值）
    if (canvasWidth !== undefined) {
      actualWidth = canvasWidth;
    }

    // 如果canvas已初始化，重新绘制
    if (ctx) {
      const canvas = ctx.canvas;
      // 重置变换
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      // 重新设置canvas尺寸（这会清除画布和变换）
      canvas.width = actualWidth * dpr;
      canvas.height = height * dpr;
      // 重新缩放（使用逻辑尺寸绘制）
      ctx.scale(dpr, dpr);
      
      // 重新绘制
      drawProgressBar();
    }
  },

  // 销毁
  destroy() {
    if (ctx) {
      ctx.clearRect(0, 0, actualWidth * dpr, height * dpr);
      ctx = null;
    }
  },
});

