// 默认配置
const defaultDotSize = 4; // 圆点大小，单位px
const defaultGap = 3; // 圆点间隔，单位px
const defaultColor = '#3678E3'; // 基础颜色
const defaultOpacities = [0.2, 0.6, 1]; // 三个圆点的透明度
const defaultDuration = 400; // 每个圆点显示的持续时间，单位ms

// 使用 Map 存储每个组件实例的状态，key 为 canvasId
const instanceMap = new Map();

// 将十六进制颜色转换为rgba格式
function hexToRgba(hex, alpha) {
  const r = parseInt(hex.slice(1, 3), 16);
  const g = parseInt(hex.slice(3, 5), 16);
  const b = parseInt(hex.slice(5, 7), 16);
  return `rgba(${r}, ${g}, ${b}, ${alpha})`;
}

// 获取或创建组件实例状态
function getInstance(canvasId) {
  if (!instanceMap.has(canvasId)) {
    instanceMap.set(canvasId, {
      dotSize: defaultDotSize,
      gap: defaultGap,
      baseColor: defaultColor,
      opacities: defaultOpacities,
      duration: defaultDuration,
      ctx: null,
      animationId: null,
      destroyed: false,
      currentStep: 0,
      lastTime: 0,
      dpr: 1,
    });
  }
  return instanceMap.get(canvasId);
}

// 计算画布尺寸
function getCanvasSize(instance) {
  // 三个圆点的宽度 + 两个间隔
  const width = instance.dotSize * 3 + instance.gap * 2;
  const height = instance.dotSize + 2; // 增加2px高度，上下各留1px空间，确保圆点垂直居中
  return { width, height };
}

export default Render({
  init(dotSizeParam, gapParam, colorParam, opacitiesParam, durationParam, canvasIdParam) {
    const canvasId = canvasIdParam || 'dotsLoaderCanvas';
    const instance = getInstance(canvasId);
    
    instance.destroyed = false;
    instance.dotSize = dotSizeParam !== undefined ? dotSizeParam : defaultDotSize;
    instance.gap = gapParam !== undefined ? gapParam : defaultGap;
    instance.baseColor = colorParam || defaultColor;
    instance.opacities = opacitiesParam || defaultOpacities;
    instance.duration = durationParam !== undefined ? durationParam : defaultDuration;
    instance.currentStep = 0;
    instance.lastTime = 0;
  },

  pageDraw(dprParam, canvasIdParam) {
    const dpr = dprParam || 1;
    const canvasId = canvasIdParam || 'dotsLoaderCanvas';
    const instance = getInstance(canvasId);
    
    instance.dpr = dpr;
    getCanvasById(canvasId, this).then(canvas => {
      instance.ctx = canvas.getContext('2d');
      const { width, height } = getCanvasSize(instance);

      // 设置canvas实际尺寸（考虑设备像素比）
      canvas.width = width * dpr;
      canvas.height = height * dpr;

      // 缩放坐标系，使得绘制时仍然使用逻辑尺寸
      instance.ctx.scale(dpr, dpr);

      // 重置动画状态
      instance.currentStep = 0;
      instance.lastTime = 0;
      
      // 启动动画
      if (instance.animationId) {
        cancelAnimationFrame(instance.animationId);
      }
      instance.destroyed = false;
      animate(canvasId);
    });
  },

  // 更新配置
  updateConfig(dotSizeParam, gapParam, colorParam, opacitiesParam, durationParam, canvasIdParam) {
    const canvasId = canvasIdParam || 'dotsLoaderCanvas';
    const instance = getInstance(canvasId);
    
    instance.dotSize = dotSizeParam !== undefined ? dotSizeParam : instance.dotSize;
    instance.gap = gapParam !== undefined ? gapParam : instance.gap;
    instance.baseColor = colorParam || instance.baseColor;
    instance.opacities = opacitiesParam || instance.opacities;
    instance.duration = durationParam !== undefined ? durationParam : instance.duration;
    
    // 如果canvas已初始化，需要重新设置尺寸
    if (instance.ctx && !instance.destroyed) {
      const { width, height } = getCanvasSize(instance);
      const canvas = instance.ctx.canvas;
      // 保存当前的变换状态
      instance.ctx.save();
      // 重置变换
      instance.ctx.setTransform(1, 0, 0, 1, 0, 0);
      // 重新设置canvas尺寸
      canvas.width = width * instance.dpr;
      canvas.height = height * instance.dpr;
      // 重新缩放
      instance.ctx.scale(instance.dpr, instance.dpr);
      instance.ctx.restore();
    }
  },

  // 销毁动画
  destroy(canvasIdParam) {
    const canvasId = canvasIdParam || 'dotsLoaderCanvas';
    const instance = getInstance(canvasId);
    
    instance.destroyed = true;
    if (instance.animationId) {
      cancelAnimationFrame(instance.animationId);
      instance.animationId = null;
    }
    if (instance.ctx) {
      const { width, height } = getCanvasSize(instance);
      instance.ctx.clearRect(0, 0, width, height);
      instance.ctx = null;
    }
    instance.currentStep = 0;
    instance.lastTime = 0;
    
    // 清理实例
    instanceMap.delete(canvasId);
  },
});

// 绘制圆点
function drawDots(instance) {
  if (!instance.ctx) return;
  
  const { width, height } = getCanvasSize(instance);
  
  // 清除画布
  instance.ctx.clearRect(0, 0, width, height);

  // 计算第一个圆点的x坐标（居中显示）
  const startX = 0;
  const centerY = height / 2; // 在增加了上下空间后，centerY会自动居中
  const radius = instance.dotSize / 2;

  // 绘制从0到currentStep的所有圆点（累积显示）
  for (let i = 0; i <= instance.currentStep; i++) {
    const x = startX + i * (instance.dotSize + instance.gap) + radius;
    const opacity = instance.opacities[i] || 1;
    const color = hexToRgba(instance.baseColor, opacity);
    
    instance.ctx.beginPath();
    instance.ctx.arc(x, centerY, radius, 0, Math.PI * 2);
    instance.ctx.fillStyle = color;
    instance.ctx.fill();
  }
}

// 动画循环
function animate(canvasId) {
  const instance = getInstance(canvasId);
  if (instance.destroyed) return;

  const now = Date.now();
  
  // 初始化时间
  if (instance.lastTime === 0) {
    instance.lastTime = now;
  }

  // 检查是否到了切换步骤的时间
  const elapsed = now - instance.lastTime;
  if (elapsed >= instance.duration) {
    instance.currentStep = (instance.currentStep + 1) % 3; // 循环：0 -> 1 -> 2 -> 0
    instance.lastTime = now;
  }

  // 绘制
  drawDots(instance);

  // 继续动画
  instance.animationId = requestAnimationFrame(() => animate(canvasId));
}

