// 默认配置
const defaultColor = '#3678E3'; // 基础颜色
const defaultOpacities = [0.2, 0.6, 1]; // 三段圆弧的透明度
const defaultRadii = [10, 16, 22]; // 三段圆弧的半径
const defaultLineWidth = 3; // 线宽
const defaultDuration = 400; // 每段圆弧显示的持续时间，单位ms
const defaultArcAngle = Math.PI / 2; // 开口角度，90度
const defaultRoundRadius = 2; // 端点圆角半径

let baseColor = defaultColor;
let opacities = defaultOpacities;
let radii = defaultRadii;
let lineWidth = defaultLineWidth;
let duration = defaultDuration;
let arcAngle = defaultArcAngle;
let roundRadius = defaultRoundRadius;

let ctx = null;
let animationId = null;
let destroyed = false;
let currentStep = 0; // 当前显示的步骤：0-第一段，1-第二段，2-第三段
let lastTime = 0;
let dpr = 1; // 设备像素比

// 将十六进制颜色转换为rgba格式
function hexToRgba(hex, alpha) {
  const r = parseInt(hex.slice(1, 3), 16);
  const g = parseInt(hex.slice(3, 5), 16);
  const b = parseInt(hex.slice(5, 7), 16);
  return `rgba(${r}, ${g}, ${b}, ${alpha})`;
}

// 计算画布尺寸
function getCanvasSize() {
  // 最大半径 + 线宽的一半 + 一些边距
  // 由于圆心居中，需要确保左右都有足够空间
  const maxRadius = Math.max(...radii);
  const width = maxRadius * 2 + lineWidth + 4;
  const height = maxRadius * 2 + lineWidth + 4;
  return { width, height };
}

// 绘制圆弧
function drawArc(centerX, centerY, radius, startAngle, endAngle, color, lineWidth) {
  if (!ctx) return;
  
  ctx.save();
  
  // 设置样式
  ctx.strokeStyle = color;
  ctx.lineWidth = lineWidth;
  ctx.lineCap = 'round'; // 使用圆角端点，让线条端点稍微圆润
  
  // 绘制圆弧
  // 使用顺时针方向（false），从左下到右上，向右开口
  ctx.beginPath();
  ctx.arc(centerX, centerY, radius, startAngle, endAngle, false);
  ctx.stroke();
  
  ctx.restore();
}

export default Render({
  init(colorParam, opacitiesParam, radiiParam, lineWidthParam, durationParam) {
    destroyed = false;
    baseColor = colorParam || defaultColor;
    opacities = opacitiesParam || defaultOpacities;
    radii = radiiParam || defaultRadii;
    lineWidth = lineWidthParam !== undefined ? lineWidthParam : defaultLineWidth;
    duration = durationParam !== undefined ? durationParam : defaultDuration;
    currentStep = 0;
    lastTime = 0;
  },

  pageDraw(dprParam) {
    dpr = dprParam || 1;
    getCanvasById('wifiSignalCanvas', this).then(canvas => {
      ctx = canvas.getContext('2d');
      const { width, height } = getCanvasSize();

      // 设置canvas实际尺寸（考虑设备像素比）
      canvas.width = width * dpr;
      canvas.height = height * dpr;

      // 缩放坐标系，使得绘制时仍然使用逻辑尺寸
      ctx.scale(dpr, dpr);

      // 重置动画状态
      currentStep = 0;
      lastTime = 0;
      
      // 启动动画
      if (animationId) {
        cancelAnimationFrame(animationId);
      }
      destroyed = false;
      animate();
    });
  },

  // 更新配置
  updateConfig(colorParam, opacitiesParam, radiiParam, lineWidthParam, durationParam) {
    baseColor = colorParam || baseColor;
    opacities = opacitiesParam || opacities;
    radii = radiiParam || radii;
    lineWidth = lineWidthParam !== undefined ? lineWidthParam : lineWidth;
    duration = durationParam !== undefined ? durationParam : duration;
    
    // 如果canvas已初始化，需要重新设置尺寸
    if (ctx && !destroyed) {
      const { width, height } = getCanvasSize();
      const canvas = ctx.canvas;
      // 保存当前的变换状态
      ctx.save();
      // 重置变换
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      // 重新设置canvas尺寸
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      // 重新缩放
      ctx.scale(dpr, dpr);
      ctx.restore();
    }
  },

  // 销毁动画
  destroy() {
    destroyed = true;
    if (animationId) {
      cancelAnimationFrame(animationId);
      animationId = null;
    }
    if (ctx) {
      const { width, height } = getCanvasSize();
      ctx.clearRect(0, 0, width, height);
      ctx = null;
    }
    currentStep = 0;
    lastTime = 0;
  },
});

// 绘制WiFi信号圆弧
function drawArcs() {
  if (!ctx) return;
  
  const { width, height } = getCanvasSize();
  
  // 清除画布
  ctx.clearRect(0, 0, width, height);

  // 计算中心点（圆弧的圆心，使整个图形在画布中水平居中）
  // WiFi信号圆弧向右开口，从-45度到45度
  // 圆弧的端点x坐标都是 centerX + radius * cos(45°)，但由于圆弧向右开口，视觉重心偏右
  // 为了让整个图形居中，需要将圆心向左偏移，使得图形的视觉中心在画布中心
  const maxRadius = Math.max(...radii);
  // 由于圆弧向右开口，视觉重心在圆心的右上方
  // 通过向左偏移圆心，使整个图形的视觉中心对齐到画布中心
  // 偏移量约为最大半径的一半，这样可以让图形更好地居中
  const horizontalOffset = maxRadius * 0.5; // 向左偏移，使视觉重心居中
  const centerX = width / 2 - horizontalOffset; // 向左偏移，使整个图形居中
  const centerY = height / 2; // 垂直居中
  
  // 绘制从0到currentStep的所有圆弧（累积显示）
  // 从左向右依次显示：第一段 -> 第一、二段 -> 第一、二、三段 -> 重新开始
  for (let i = 0; i <= currentStep; i++) {
    const radius = radii[i];
    const opacity = opacities[i] || 1;
    const color = hexToRgba(baseColor, opacity);
    
    // 计算圆弧的起始和结束角度
    // 圆弧水平向右延伸，圆心在左侧
    // canvas角度系统：0度=向右，Math.PI/2=向下，Math.PI=向左，3*Math.PI/2=向上
    // 从270度（向上）顺时针旋转45度：270+45=315度（左下）
    // 从0度（向右）顺时针旋转45度：0+45=45度（右上）
    // 从315度顺时针到45度正好是90度，圆弧向右开口
    const startAngle = -Math.PI / 4; // -45度 = 315度（左下）
    const endAngle = Math.PI / 4; // 45度（右上）
    
    // 绘制圆弧
    drawArc(
      centerX,
      centerY,
      radius,
      startAngle,
      endAngle,
      color,
      lineWidth
    );
  }
}

// 动画循环
function animate() {
  if (destroyed) return;

  const now = Date.now();
  
  // 初始化时间
  if (lastTime === 0) {
    lastTime = now;
  }

  // 检查是否到了切换步骤的时间
  const elapsed = now - lastTime;
  if (elapsed >= duration) {
    // 从左向右依次显示：0 -> 1 -> 2 -> 0（循环）
    // 三段都显示后，重新从第一段开始
    currentStep = (currentStep + 1) % 3;
    lastTime = now;
  }

  // 绘制
  drawArcs();

  // 继续动画
  animationId = requestAnimationFrame(animate);
}
