{
  "compileOnSave": false,
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2015",
    "module": "ESNext",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmitOnError": false,
    "jsx": "react-jsx",
    "paths": {
      "ray": [
  "./node_modules/@ray-js/ray-next"
],
      "@/*": [
        "./src/*"
      ],
      "@/components/*": [
        "./src/components/*"
      ]
    },
    "types": [
  "node",
  "@tuya-miniapp/api-types"
],
    "typeRoots": [
  "./typings",
  "./node_modules"
]
  },
  "include": [
    "src/**/*.*",
    "typings"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "public"
  ]
}
